AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_TRUST_HOST=true

# skilltrack-dev for local and Vercel Preview; skilltrack-prod for Vercel Production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required to store Tracky API keys. Dual-read still accepts TRACK_ENCRYPTION_KEY.
TRACKY_ENCRYPTION_KEY=

# Local Playwright authenticated flows only. Never set this on Vercel Production.
E2E_SECRET=
